+            "type": "object",
+            "properties": {
+                "reservation_id": {"type": "string"},
+            },
+            "required": ["reservation_id"],
+        }
+
+    def execute(self, context: ToolContext, arguments: dict[str, Any]) -> dict[str, Any]:
+        rid = str(arguments.get("reservation_id", "")).strip()
+        client = get_external_client()
