+                arguments={
+                    "guest_name": "Ada",
+                    "check_in": "2026-11-01",
+                    "check_out": "2026-11-03",
+                },
+                task_id=tid,
+            )
+        assert "consultation" in str(ei.value).lower() or "side-effect" in str(ei.value).lower()
