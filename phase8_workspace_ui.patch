diff --git a/app/static/workspace/styles.css b/app/static/workspace/styles.css
new file mode 100644
index 0000000..32c8653
--- /dev/null
+++ b/app/static/workspace/styles.css
@@ -0,0 +1,178 @@
+:root {
+  --bg: #0f1419;
+  --panel: #171d25;
+  --panel-2: #1e2630;
+  --border: #2a3441;
+  --text: #e7eef7;
+  --muted: #93a1b3;
+  --accent: #3b82f6;
+  --accent-2: #22c55e;
+  --warn: #f59e0b;
+  --danger: #ef4444;
+  --radius: 12px;
+  --font: "Segoe UI", system-ui, -apple-system, sans-serif;
+}
+* { box-sizing: border-box; }
+body {
+  margin: 0;
+  font-family: var(--font);
+  background: radial-gradient(1200px 600px at 10% -10%, #1a2740 0%, var(--bg) 55%);
+  color: var(--text);
+  min-height: 100vh;
+}
+#app { display: grid; grid-template-columns: 260px 1fr; min-height: 100vh; }
+.sidebar {
+  background: rgba(15, 20, 25, 0.92);
+  border-right: 1px solid var(--border);
+  padding: 1.25rem 1rem;
+  display: flex;
+  flex-direction: column;
+  gap: 1.25rem;
+}
+.brand { display: flex; gap: 0.75rem; align-items: center; }
+.logo {
+  width: 40px; height: 40px; border-radius: 10px;
+  background: linear-gradient(135deg, #3b82f6, #8b5cf6);
+  display: grid; place-items: center; font-weight: 700;
+}
+.brand small { display: block; color: var(--muted); }
+nav { display: flex; flex-direction: column; gap: 0.35rem; }
+.nav-btn {
+  text-align: left;
+  background: transparent;
+  border: 1px solid transparent;
+  color: var(--muted);
+  padding: 0.65rem 0.8rem;
+  border-radius: 8px;
+  cursor: pointer;
+}
+.nav-btn:hover:not(:disabled) { background: var(--panel-2); color: var(--text); }
+.nav-btn.active { background: var(--panel-2); color: var(--text); border-color: var(--border); }
+.nav-btn:disabled { opacity: 0.4; cursor: not-allowed; }
+.session {
+  margin-top: auto;
+  padding: 0.75rem;
+  background: var(--panel);
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  font-size: 0.8rem;
+  color: var(--muted);
+  word-break: break-all;
+}
+.main { padding: 1.25rem 1.5rem 2rem; }
+.topbar {
+  display: flex; justify-content: space-between; align-items: center;
+  margin-bottom: 1rem;
+}
+.topbar h1 { margin: 0; font-size: 1.35rem; }
+.pill {
+  display: inline-block;
+  padding: 0.25rem 0.65rem;
+  border-radius: 999px;
+  font-size: 0.75rem;
+  border: 1px solid var(--border);
+}
+.pill.ok { background: rgba(34,197,94,0.15); color: #86efac; }
+.pill.muted { color: var(--muted); }
+.view { display: none; }
+.view.active { display: block; }
+.card {
+  background: rgba(23, 29, 37, 0.9);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: 1rem 1.1rem;
+  margin-bottom: 1rem;
+}
+.card h2, .card h3 { margin-top: 0; }
+.muted { color: var(--muted); }
+.grid-2 {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 0.75rem;
+}
+label { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.85rem; color: var(--muted); }
+label.full { grid-column: 1 / -1; }
+input, select, textarea {
+  background: var(--panel-2);
+  border: 1px solid var(--border);
+  color: var(--text);
+  border-radius: 8px;
+  padding: 0.55rem 0.7rem;
+  font: inherit;
+}
+button {
+  border: none;
+  border-radius: 8px;
+  padding: 0.55rem 0.9rem;
+  font: inherit;
+  cursor: pointer;
+}
+button.primary { background: var(--accent); color: white; }
+button.secondary { background: var(--panel-2); color: var(--text); border: 1px solid var(--border); }
+button.danger { background: rgba(239,68,68,0.2); color: #fecaca; border: 1px solid #7f1d1d; }
+button.success { background: rgba(34,197,94,0.2); color: #bbf7d0; border: 1px solid #14532d; }
+.row { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin-top: 0.75rem; }
+.row.between { justify-content: space-between; }
+.log {
+  margin-top: 0.75rem;
+  background: #0b0f14;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  padding: 0.75rem;
+  max-height: 280px;
+  overflow: auto;
+  font-size: 0.8rem;
+  white-space: pre-wrap;
+}
+.stats {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 0.75rem;
+  margin-bottom: 1rem;
+}
+.stat {
+  background: var(--panel);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: 1rem;
+}
+.stat .n { font-size: 1.6rem; font-weight: 700; }
+.stat .l { color: var(--muted); font-size: 0.8rem; }
+.list { display: flex; flex-direction: column; gap: 0.5rem; }
+.item {
+  background: var(--panel-2);
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  padding: 0.7rem 0.8rem;
+  font-size: 0.9rem;
+}
+.item .meta { color: var(--muted); font-size: 0.75rem; margin-top: 0.25rem; }
+.cards {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
+  gap: 0.75rem;
+}
+.agent-card {
+  background: var(--panel-2);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  padding: 0.9rem;
+}
+.agent-card h4 { margin: 0 0 0.35rem; }
+.tag {
+  display: inline-block;
+  font-size: 0.7rem;
+  padding: 0.15rem 0.4rem;
+  border-radius: 6px;
+  background: #243044;
+  color: #c7d2fe;
+  margin: 0.15rem 0.15rem 0 0;
+}
+hr { border: none; border-top: 1px solid var(--border); margin: 1rem 0; }
+code { background: #0b0f14; padding: 0.1rem 0.3rem; border-radius: 4px; }
+@media (max-width: 900px) {
+  #app { grid-template-columns: 1fr; }
+  .sidebar { border-right: none; border-bottom: 1px solid var(--border); }
+  .stats { grid-template-columns: 1fr 1fr; }
+  .grid-2 { grid-template-columns: 1fr; }
+}
diff --git a/tests/test_workspace_ui.py b/tests/test_workspace_ui.py
