+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1" />
+  <title>Forgot password · AI Employee Platform</title>
+  <link rel="stylesheet" href="/workspace/assets/styles.css" />
+  <style>
+    body.auth-page {
+      min-height: 100vh;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      background: linear-gradient(160deg, #0f172a 0%, #1e293b 45%, #0f172a 100%);
+      margin: 0;
+      font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
+    }
+    .auth-card {
+      width: min(420px, 92vw);
+      background: #fff;
+      border-radius: 14px;
+      padding: 1.75rem 1.5rem 1.5rem;
+      box-shadow: 0 20px 50px rgba(0,0,0,.35);
+    }
+    .auth-card h1 {
+      margin: 0 0 .35rem;
+      font-size: 1.35rem;
+      color: #0f172a;
+    }
+    .auth-card .sub {
+      margin: 0 0 1.25rem;
+      color: #64748b;
+      font-size: .9rem;
+      line-height: 1.45;
+    }
+    .auth-card label {
+      display: block;
+      margin-bottom: .85rem;
+      font-size: .85rem;
+      color: #334155;
+      font-weight: 500;
+    }
+    .auth-card input {
+      display: block;
+      width: 100%;
+      margin-top: .35rem;
+      padding: .55rem .7rem;
+      border: 1px solid #e2e8f0;
+      border-radius: 8px;
+      font-size: .95rem;
+      box-sizing: border-box;
+    }
+    .auth-card input:focus {
+      outline: 2px solid #3b82f6;
+      border-color: transparent;
+    }
+    .password-field {
+      display: flex;
+      gap: .4rem;
+      align-items: center;
+      margin-top: .35rem;
+    }
+    .password-field input { margin-top: 0; flex: 1; }
+    .password-toggle {
+      border: 1px solid #e2e8f0;
+      background: #f8fafc;
+      border-radius: 8px;
+      padding: .5rem .65rem;
+      font-size: .8rem;
+      cursor: pointer;
+    }
+    .btn {
+      display: block;
+      width: 100%;
+      border: none;
+      border-radius: 8px;
+      padding: .7rem 1rem;
+      font-size: .95rem;
+      font-weight: 600;
+      cursor: pointer;
+      margin-top: .25rem;
+    }
+    .btn-primary { background: #2563eb; color: #fff; }
+    .btn-primary:disabled { opacity: .6; cursor: not-allowed; }
+    .btn-secondary { background: #f1f5f9; color: #0f172a; margin-top: .5rem; }
+    .msg {
+      margin-top: .85rem;
+      font-size: .85rem;
+      color: #64748b;
+      white-space: pre-wrap;
+      min-height: 1.2em;
+    }
+    .msg.error { color: #b91c1c; }
+    .msg.ok { color: #166534; }
+    .auth-footer {
+      margin-top: 1.25rem;
+      text-align: center;
+      font-size: .85rem;
+    }
+    .auth-footer a { color: #2563eb; text-decoration: none; }
+    .auth-footer a:hover { text-decoration: underline; }
+    .brand {
+      display: flex;
+      align-items: center;
+      gap: .65rem;
+      margin-bottom: 1.25rem;
+    }
+    .brand .logo {
+      width: 40px; height: 40px;
+      border-radius: 10px;
+      background: #2563eb;
+      color: #fff;
+      display: grid;
+      place-items: center;
+      font-weight: 700;
+    }
+    .step { display: none; }
+    .step.active { display: block; }
+    .token-box {
+      font-family: ui-monospace, monospace;
+      font-size: .75rem;
+      background: #f8fafc;
+      border: 1px dashed #cbd5e1;
+      border-radius: 8px;
+      padding: .5rem;
+      word-break: break-all;
+      margin: .5rem 0;
+    }
+  </style>
+</head>
+<body class="auth-page">
+  <div class="auth-card">
+    <div class="brand">
+      <div class="logo">AI</div>
+      <div>
+        <strong>AI Employee Platform</strong>
+        <div style="font-size:.8rem;color:#64748b">Account recovery</div>
+      </div>
+    </div>
+
+    <!-- Step 1: request -->
+    <div id="stepRequest" class="step active">
+      <h1>Forgot password</h1>
+      <p class="sub">Enter the email used for your account. We will issue a password reset if the account exists.</p>
+      <label>Email
+        <input id="email" type="email" autocomplete="username" placeholder="you@company.com" />
+      </label>
+      <button type="button" id="btnRequest" class="btn btn-primary">Continue</button>
+      <p id="requestMsg" class="msg" role="status"></p>
+    </div>
+
+    <!-- Step 2: set new password -->
+    <div id="stepReset" class="step">
+      <h1>Set new password</h1>
+      <p class="sub">Choose a new password (at least 8 characters).</p>
+      <div id="tokenDebug" class="hidden">
+        <p class="sub" style="margin-bottom:.25rem">Development token (would be emailed in production):</p>
+        <div id="tokenPreview" class="token-box"></div>
+      </div>
+      <label class="hidden" id="tokenLabel">Reset token
+        <input id="token" type="text" autocomplete="off" />
+      </label>
+      <label>New password
+        <div class="password-field">
+          <input id="newPassword" type="password" autocomplete="new-password" placeholder="Min. 8 characters" />
+          <button type="button" class="password-toggle" id="btnShow1">Show</button>
+        </div>
+      </label>
+      <label>Confirm password
+        <div class="password-field">
+          <input id="confirmPassword" type="password" autocomplete="new-password" placeholder="Repeat password" />
+          <button type="button" class="password-toggle" id="btnShow2">Show</button>
+        </div>
+      </label>
+      <button type="button" id="btnReset" class="btn btn-primary">Update password</button>
+      <button type="button" id="btnBack" class="btn btn-secondary">Back</button>
+      <p id="resetMsg" class="msg" role="status"></p>
+    </div>
+
+    <!-- Step 3: done -->
+    <div id="stepDone" class="step">
+      <h1>Password updated</h1>
+      <p class="sub">You can sign in with your new password.</p>
+      <a class="btn btn-primary" href="/workspace" style="text-align:center;text-decoration:none;box-sizing:border-box">Go to sign in</a>
+    </div>
+
+    <div class="auth-footer">
+      <a href="/workspace">← Back to sign in</a>
+    </div>
+  </div>
+
+  <script>
+    const $ = (id) => document.getElementById(id);
+    const params = new URLSearchParams(location.search);
+    const API = "/api/v1";
+
+    function showStep(name) {
+      ["stepRequest", "stepReset", "stepDone"].forEach((id) => {
+        $(id).classList.toggle("active", id === name);
+      });
+    }
+
+    function togglePw(inputId, btnId) {
+      const input = $(inputId);
+      const btn = $(btnId);
+      const show = input.type === "password";
+      input.type = show ? "text" : "password";
+      btn.textContent = show ? "Hide" : "Show";
+    }
+
+    $("btnShow1").onclick = () => togglePw("newPassword", "btnShow1");
+    $("btnShow2").onclick = () => togglePw("confirmPassword", "btnShow2");
+    $("btnBack").onclick = () => showStep("stepRequest");
+
+    // Prefill from query ?email= & ?token=
+    if (params.get("email")) $("email").value = params.get("email");
+    if (params.get("token")) {
+      $("token").value = params.get("token");
+      $("tokenLabel").classList.remove("hidden");
+      showStep("stepReset");
+    }
+
+    $("btnRequest").onclick = async () => {
+      const msg = $("requestMsg");
+      const btn = $("btnRequest");
+      msg.className = "msg";
+      msg.textContent = "";
+      const email = ($("email").value || "").trim();
+      if (!email) {
+        msg.className = "msg error";
+        msg.textContent = "Email is required.";
+        return;
+      }
+      btn.disabled = true;
+      btn.textContent = "Please wait…";
+      try {
+        const res = await fetch(API + "/auth/forgot-password", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ email }),
+        });
+        const data = await res.json().catch(() => ({}));
+        if (!res.ok) throw new Error(data.detail || res.statusText);
+        msg.className = "msg ok";
+        msg.textContent = data.message || "If an account exists, instructions were issued.";
+        // Dev mode: token returned — advance to reset form
+        if (data.reset_token) {
+          $("token").value = data.reset_token;
+          $("tokenPreview").textContent = data.reset_token;
+          $("tokenDebug").classList.remove("hidden");
+          $("tokenLabel").classList.remove("hidden");
+          showStep("stepReset");
+        }
+      } catch (err) {
+        msg.className = "msg error";
+        msg.textContent = err.message || "Request failed";
+      } finally {
+        btn.disabled = false;
+        btn.textContent = "Continue";
+      }
+    };
+
+    $("btnReset").onclick = async () => {
+      const msg = $("resetMsg");
+      const btn = $("btnReset");
+      msg.className = "msg";
+      const token = ($("token").value || "").trim();
+      const pw = $("newPassword").value || "";
+      const conf = $("confirmPassword").value || "";
+      if (!token) {
+        msg.className = "msg error";
+        msg.textContent = "Reset token is required.";
+        return;
+      }
+      if (pw.length < 8) {
+        msg.className = "msg error";
+        msg.textContent = "Password must be at least 8 characters.";
+        return;
+      }
+      if (pw !== conf) {
+        msg.className = "msg error";
+        msg.textContent = "Passwords do not match.";
+        return;
+      }
+      btn.disabled = true;
+      btn.textContent = "Updating…";
+      try {
+        const res = await fetch(API + "/auth/reset-password", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ token, new_password: pw }),
+        });
+        const data = await res.json().catch(() => ({}));
+        if (!res.ok) {
+          const detail = data.detail;
+          throw new Error(typeof detail === "string" ? detail : JSON.stringify(detail || data));
+        }
+        showStep("stepDone");
+      } catch (err) {
+        msg.className = "msg error";
+        msg.textContent = err.message || "Reset failed";
+      } finally {
+        btn.disabled = false;
+        btn.textContent = "Update password";
+      }
+    };
+
+    $("email").addEventListener("keydown", (e) => {
+      if (e.key === "Enter") $("btnRequest").click();
+    });
+  </script>
+</body>
+</html>
