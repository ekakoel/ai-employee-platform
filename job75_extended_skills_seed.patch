+"""Extended platform skill seed — regression checks."""
+
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+from app.core.database import Base, get_db
+from app.main import app
+from app.services.seed import seed_catalog, seed_demo_company_skills
+from app.models.entities import Skill
+from sqlalchemy import select
+
+engine = create_engine(
+    "sqlite:///./test_skills_extended.db",
+    connect_args={"check_same_thread": False},
+)
+SessionLocal = sessionmaker(bind=engine, autoflush=False, autocommit=False)
+
+
+@pytest.fixture()
+def client():
+    Base.metadata.drop_all(bind=engine)
+    Base.metadata.create_all(bind=engine)
+    with SessionLocal() as db:
+        seed_catalog(db)
+
+    def override():
+        db = SessionLocal()
+        try:
+            yield db
+        finally:
+            db.close()
+
+    prev = app.dependency_overrides.get(get_db)
+    app.dependency_overrides[get_db] = override
+    with TestClient(app) as c:
+        yield c
+    if prev is None:
+        app.dependency_overrides.pop(get_db, None)
+    else:
+        app.dependency_overrides[get_db] = prev
+
+
+EXPECTED_PLATFORM_SLUGS = {
+    "availability_check",
+    "reservation_management",
+    "booking_support",
+    "quotation_preparation",
+    "customer_follow_up",
+    "invoice_draft_preparation",
+    "expense_anomaly_detection",
+    "lead_qualification",
+    "faq_response",
+    "contract_analysis",
+    "contract_extraction",
+    "contract_validation",
+}
+
+
+def test_platform_skills_extended_seeded(client):
+    co = client.post("/api/v1/companies", json={"name": "Skill Ext Co"}).json()
+    # platform admin / owner path may vary; use seed DB directly if API gated
+    with SessionLocal() as db:
+        rows = list(
+            db.scalars(select(Skill).where(Skill.company_id.is_(None))).all()
+        )
+        slugs = {s.slug for s in rows}
+        missing = EXPECTED_PLATFORM_SLUGS - slugs
+        assert not missing, f"Missing platform skills: {missing}"
+        assert len(rows) >= 12
+
+
+def test_quotation_preparation_uses_draft_quotation_tool(client):
+    with SessionLocal() as db:
+        skill = db.scalar(
+            select(Skill).where(
+                Skill.slug == "quotation_preparation",
+                Skill.company_id.is_(None),
+            )
+        )
+        assert skill is not None
+        assert "draft_quotation" in (skill.allowed_tools or [])
+
+
+def test_demo_company_skill_hotel_upsell(client):
+    with SessionLocal() as db:
+        # create a fake company id via seed path if companies table exists
+        from app.models.entities import Company
+        co = Company(name="Demo Upsell Co")
+        db.add(co)
+        db.flush()
+        skills = seed_demo_company_skills(db, company_id=co.id)
+        db.commit()
+        assert any(s.slug == "hotel_upsell_package" for s in skills)
+        assert all(s.company_id == co.id for s in skills)
