APP_NAME=AI Employee Platform
APP_ENV=development
DEBUG=true

# SQLite (local / tests)
DATABASE_URL=sqlite:///./ai_employee.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+psycopg://aiep:aiep@localhost:5432/aiep
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Auth
AUTH_ENABLED=false
ALLOW_LEGACY_USER_HEADER=true
JWT_REFRESH_EXPIRE_MINUTES=20160
JWT_SECRET=dev-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# Workers
WORKER_POLL_SECONDS=30

# Observability
LOG_LEVEL=INFO
LOG_JSON=false

# LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# Platform admin (Job 23)
PLATFORM_ADMIN_EMAILS=
ALLOW_IMPERSONATION=false

# Migrations: production containers run `alembic upgrade head` on start (Job 24)

# Object storage (Job 25): local | s3
# STORAGE_BACKEND=s3
# S3_BUCKET=aiep-documents
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=  # set for MinIO/LocalStack e.g. http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Vector knowledge (Job 26)
KNOWLEDGE_VECTOR=false
EMBEDDING_PROVIDER=fake
EMBEDDING_DIMS=64
HYBRID_KEYWORD_WEIGHT=0.4
HYBRID_VECTOR_WEIGHT=0.6

# LLM cost estimates (Job 28) — USD per 1K tokens; local Ollama usually 0
LLM_COST_PER_1K_PROMPT_TOKENS=0.0
LLM_COST_PER_1K_COMPLETION_TOKENS=0.0
LLM_DAILY_BUDGET_USD=0
