APP_NAME=AI Employee Platform
APP_ENV=development
DEBUG=true

# SQLite (local / tests)
DATABASE_URL=sqlite:///./ai_employee.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+psycopg://aiep:aiep@localhost:5432/aiep
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Auth
AUTH_ENABLED=false
ALLOW_LEGACY_USER_HEADER=true
JWT_REFRESH_EXPIRE_MINUTES=20160
JWT_SECRET=dev-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# Workers
WORKER_POLL_SECONDS=30

# Observability
LOG_LEVEL=INFO
LOG_JSON=false

# LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# Platform admin (Job 23)
PLATFORM_ADMIN_EMAILS=
ALLOW_IMPERSONATION=false

# Migrations: production containers run `alembic upgrade head` on start (Job 24)
