+    wf = client.post(
+        f"/api/v1/companies/{company_id}/workflows",
+        headers=headers,
+        json={
+            "name": "Daily briefing",
+            "steps": [
+                {
+                    "type": "create_task",
+                    "agent_instance_id": agent_id,
+                    "title": "Briefing",
+                    "instruction": "Summarize open items",
+                    "mode": "consult",
