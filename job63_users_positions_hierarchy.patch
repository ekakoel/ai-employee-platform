diff --git a/tests/test_users_positions_job63.py b/tests/test_users_positions_job63.py
new file mode 100644
index 0000000..b82fb75
--- /dev/null
+++ b/tests/test_users_positions_job63.py
@@ -0,0 +1,61 @@
+"""Job 63 — users & job positions UI + role update."""
+
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+
+from app.main import app
+
+client = TestClient(app)
+
+
+def _owner():
+    demo = client.post("/api/v1/demo/bootstrap")
+    assert demo.status_code == 200, demo.text
+    body = demo.json()
+    login = client.post(
+        "/api/v1/auth/login",
+        json={"email": body["owner_email"], "password": "demo12345"},
+    )
+    assert login.status_code == 200, login.text
+    tok = login.json()
+    headers = {
+        "Authorization": f"Bearer {tok['access_token']}",
+        "X-User-ID": tok["user_id"],
+    }
+    return body, headers
+
+
+def test_app_js_syntax_btn_refresh_users():
+    js = Path("app/static/workspace/app.js").read_text(encoding="utf-8")
+    assert 'if ($("btnRefreshUsers")) $("btnRefreshUsers").onclick = loadUsers;' in js
+    assert 'if ($("btnRefreshUsers") $("btnRefreshUsers")' not in js
+
+
+def test_invite_and_change_position():
+    body, headers = _owner()
+    company_id = body["company_id"]
+    # pick a non-owner user from bootstrap
+    target = next(u for u in body["users"] if u["role"] == "reservation")
+    res = client.put(
+        f"/api/v1/companies/{company_id}/users/{target['id']}/role",
+        headers=headers,
+        json={"role_name": "contract_manager"},
+    )
+    assert res.status_code == 200, res.text
+    assert res.json()["role"] == "contract_manager"
+
+    inv = client.post(
+        f"/api/v1/companies/{company_id}/invitations",
+        headers=headers,
+        json={"email": "desk@example.test", "role_name": "ai_admin"},
+    )
+    assert inv.status_code == 201, inv.text
+    assert inv.json().get("role_name") == "ai_admin"
+
+
+def test_users_view_hierarchy_copy():
+    html = client.get("/workspace").text
+    assert "Users &amp; job positions" in html or "Users & job positions" in html
+    assert "AI Administrator" in html
+    assert "userRoleInput" in html
