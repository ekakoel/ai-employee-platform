+    assert resp.status_code in (200, 201), resp.text
+    notes = client.get(
+        f"/api/v1/companies/{company_id}/notifications",
+        headers=headers,
+    )
+    assert notes.status_code == 200
+    types = [n["type"] for n in notes.json()]
