+        company_id=company_id,
+        user_id=user.id,
+        action="policy.create",
+        resource_type="policy",
+        resource_id=policy.id,
+        status="success",
+        details={"name": policy.name, "tool": cfg.get("tool") or cfg.get("action")},
+    )
+    db.commit()
+    db.refresh(policy)
+    return policy
