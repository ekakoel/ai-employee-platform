--- /dev/null
+++ b/tests/test_results_governance_job73.py
@@ -0,0 +1,22 @@
+"""Job 73 — results/governance/usage docs and notices."""
+
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+
+from app.main import app
+
+client = TestClient(app)
+
+
+def test_governance_and_usage_notices():
+    html = client.get("/workspace").text
+    assert 'id="view-governance"' in html
+    assert "Governance" in html
+    assert 'id="view-usage"' in html
+    assert "outputCenter" in html
+
+
+def test_docs():
+    assert Path("docs/features/16_results_governance.md").is_file()
+    assert Path("docs/features/17_MVP_QA_CHECKLIST.md").is_file()
